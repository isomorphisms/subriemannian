module Reproduce

import Data.List
import Data.Text
import System
import System.File

covering
capture : List Text → IO Text
capture command = do
  opened ← Escaped.popen command Read
  case opened of
    Left error ⇒ die ("cannot launch reproduction: " ++ show error)
    Right stream ⇒ do
      result ← fRead stream
      status ← pclose stream
      case result of
        Left error ⇒ die ("cannot read reproduction output: " ++ show error)
        Right output ⇒ if status ≟ 0 then pure output else die ("reproduction command failed\n" ++ output)

absolute : Text → Bool
absolute path = isPrefixOf "/" path && not (isInfixOf "\n" path) && not (isInfixOf "\t" path)

expected_pin : Text → Text → Maybe Text
expected_pin key ledger = case filter (\row ⇒ case words row of first :: _ ⇒ first ≟ key; _ ⇒ False) (lines ledger) of
  [row] ⇒ case words row of [_,_,pin] ⇒ Just pin; _ ⇒ Nothing
  _ ⇒ Nothing

covering
verify_pin : Text → Text → Text → IO ()
verify_pin ledger key root = do
  observed ← trim <$> capture ["git","-C",root,"rev-parse","HEAD"]
  case expected_pin key ledger of
    Just expected ⇒ if observed ≟ expected then pure () else die ("dependency pin mismatch: " ++ key)
    Nothing ⇒ die ("missing or malformed dependency pin: " ++ key)
  dirty ← capture ["git","-C",root,"status","--porcelain","--untracked-files=no"]
  if trim dirty ≟ "" then pure () else die ("dirty tracked dependency: " ++ key)

covering
run : List Text → IO ()
run [project, idric, fp, kitchen, aici, evidence] = do
  if all absolute [project,idric,fp,kitchen,aici,evidence] then pure () else die "absolute roots required"
  present ← exists evidence
  if present then die "use a new evidence root; prior receipts must not be overwritten" else pure ()
  ledger ← readFile (project ++ "/ci/dependencies.tsv")
  case ledger of
    Left error ⇒ die ("cannot read dependency pins: " ++ show error)
    Right pins ⇒ traverse_ (\(key,root) ⇒ verify_pin pins key root)
      [("idric",idric),("flexible-pipes",fp),("kitchen",kitchen),("ai-ci",aici)]
  ignore $ setEnv "CHEZ" (idric ++ "/_/.tools/bin/scheme") True
  ignore $ setEnv "IDRIS2_PREFIX" (idric ++ "/_/bootstrap-build") True
  ignore $ setEnv "IDRIS2_PATH" (idric ++ "/_/libs/prelude/build/ttc:" ++ idric ++ "/_/libs/base/build/ttc") True
  let driver_directory = evidence ++ "/driver"
      artifact_directory = evidence ++ "/artifacts"
      pipeline_parameters = ["compiler=" ++ idric ++ "/_/build/exec/idris2",
        "driver-source-directory=" ++ kitchen ++ "/examples/autogenerated/subriemannian-build",
        "driver-source=" ++ kitchen ++ "/examples/autogenerated/subriemannian-build/Build.idric",
        "driver-ttc=" ++ driver_directory ++ "/ttc",
        "driver-directory=" ++ driver_directory,
        "driver=" ++ driver_directory ++ "/kitchen-build",
        "project=" ++ project, "idric=" ++ idric, "kitchen=" ++ kitchen, "aici=" ++ aici,
        "artifacts=" ++ artifact_directory,"accept=" ++ artifact_directory ++ "/aici-accept"]
  -- The existing FP entrypoint is a nonexecutable Python source file.
  output ← capture (["python3",fp ++ "/scripts/run-pipeline","subriemannian-01","--runs-root",evidence ++ "/fp"] ++
    concatMap (\parameter ⇒ ["--param",parameter]) pipeline_parameters)
  putStrLn output
run _ = die "usage: reproduce PROJECT_ROOT IDRIC_ROOT FP_ROOT KITCHEN_ROOT AICI_ROOT NEW_EVIDENCE_ROOT"

covering
main : IO ()
main = do
  arguments ← getArgs
  run (drop 1 arguments)
